{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Link",
                    "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
                }
            ]
        },
        {
            "source": "/.well-known/api-catalog",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/linkset+json"
                }
            ]
        },
        {
            "source": "/fontawesome/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/fonts/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/flags/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/logo/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/images/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
            "source": "/products/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
            "source": "/testimonials/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
            "source": "/(favicon.ico|favicon.png|apple-touch-icon.png|icon-192.png|icon-512.png|og-default.png|og-default.svg|site.webmanifest)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        }
    ]
}
