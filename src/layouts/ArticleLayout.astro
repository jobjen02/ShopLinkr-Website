---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import type { Locale, RouteKey } from '../i18n/routes';

interface Props {
    title: string;
    description: string;
    heading: string;
    subheading?: string;
    eyebrow?: string;
    image?: string;
    imageAlt?: string;
    meta?: string;
    backHref?: string;
    backLabel?: string;
    locale?: Locale;
    routeKey?: RouteKey;
    alternates?: { nl?: string; en?: string };
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
    publishedTime?: string;
    authorName?: string;
}

const {
    title,
    description,
    heading,
    subheading,
    eyebrow,
    image,
    imageAlt,
    meta,
    backHref,
    backLabel,
    locale,
    routeKey,
    alternates,
    jsonLd,
    publishedTime,
    authorName,
} = Astro.props;

const resolvedLocale = (locale ?? Astro.currentLocale ?? 'nl') as Locale;
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    locale={locale}
    routeKey={routeKey}
    alternates={alternates}
    jsonLd={jsonLd}
    ogType="article"
    publishedTime={publishedTime}
    markdown
>
    <article class="pt-10 md:pt-16 pb-12 md:pb-32 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            {backHref && backLabel && (
                <a
                    href={backHref}
                    class="inline-flex items-center gap-2 text-sm text-gravel hover:text-charcoal dark:hover:text-paper transition-colors mb-10"
                >
                    <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
                    {backLabel}
                </a>
            )}

            <header class="max-w-3xl">
                {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
                <h1 class="text-4xl md:text-5xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {heading}
                </h1>
                {subheading && (
                    <p class="mt-6 text-lg md:text-xl text-steel dark:text-gravel leading-relaxed">
                        {subheading}
                    </p>
                )}
                {meta && (
                    <p class="mt-6 text-sm text-gravel">
                        {meta}
                    </p>
                )}
            </header>

            {image && (
                <div class="mt-12 max-w-4xl">
                    <img
                        src={image}
                        alt={imageAlt ?? ''}
                        class="w-full aspect-video object-cover rounded-xl ring-1 ring-chalk-dark dark:ring-flint"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />
                </div>
            )}

            <div class="prose-shoplinkr mt-12 max-w-3xl">
                <slot />
            </div>

            <div class="max-w-3xl">
                <AuthorBio name={authorName} locale={resolvedLocale} />
            </div>
        </div>
    </article>

    <slot name="after" />
</BaseLayout>
