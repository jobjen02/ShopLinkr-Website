---
import { getCollection } from 'astro:content';
import SeoArticlePage from '../components/pages/SeoArticlePage.astro';
import { authorSchema } from '../utils/author';
import { guideGroupOf } from '../utils/guides';
import { dateModified } from '../utils/articleDate';
import { extractSteps, howToSchema } from '../utils/howto';

const { slug } = Astro.params;

// Astro matches explicit routes (e.g. /prijzen) before this root catch-all, so
// any path that is not an SEO page slug simply falls through to 404 here.
const pages = await getCollection('seoPages');
const page = pages.find((p) => p.id === slug);
if (!page) return Astro.rewrite('/404');

const pagesEn = await getCollection('seoPagesEn');
const enSlug = pagesEn.find((p) => p.data.translationKey === page.id)?.id ?? null;

// Related guides from the same theme group, so each guide links to its siblings.
const group = guideGroupOf(page.id);
const related = pages
    .filter((p) => p.id !== page.id && guideGroupOf(p.id) === group)
    .slice(0, 3)
    .map((p) => ({ title: p.data.title, excerpt: p.data.excerpt, href: `/${p.id}` }));

const alternates = enSlug
    ? { nl: `/${page.id}`, en: `/en/${enSlug}` }
    : undefined;

const canonicalUrl = `https://shoplinkr.com/${page.id}`;

const articleSchema = {
    '@type': 'Article',
    headline: page.data.title,
    description: page.data.excerpt,
    datePublished: page.data.publishedAt.toISOString(),
    dateModified: dateModified(page.data.publishedAt, page.data.updatedAt).toISOString(),
    inLanguage: 'nl-NL',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    author: authorSchema(page.data.author, 'nl'),
    publisher: { '@id': 'https://shoplinkr.com/#organization' },
    ...(page.data.image && { image: `https://shoplinkr.com${page.data.image}` }),
    ...(page.data.category && { articleSection: page.data.category }),
};

const breadcrumbSchema = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shoplinkr.com' },
        { '@type': 'ListItem', position: 2, name: 'Gidsen', item: 'https://shoplinkr.com/gidsen' },
        { '@type': 'ListItem', position: 3, name: page.data.title, item: canonicalUrl },
    ],
};

// Connection guides ("hoe-koppel-ik-...") carry an explicit step sequence; expose
// it as a HowTo so AI engines can cite the procedure. First <ol> = the connect
// steps (a later <ol> is a different task and is ignored by 'first-ol').
const howTo = page.id.startsWith('hoe-koppel-ik-')
    ? howToSchema({
        name: page.data.title,
        description: page.data.excerpt,
        url: canonicalUrl,
        inLanguage: 'nl-NL',
        steps: extractSteps(page.body ?? '', 'first-ol'),
    })
    : null;

const jsonLd = howTo
    ? [articleSchema, breadcrumbSchema, howTo]
    : [articleSchema, breadcrumbSchema];

export const prerender = false;
---

<SeoArticlePage page={page} related={related} alternates={alternates} jsonLd={jsonLd} />
