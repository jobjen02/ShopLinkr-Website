---
import CustomerStoryDetailPage from '../../components/pages/CustomerStoryDetailPage.astro';
import { findCustomerStory } from '../../data/customerStories';

const { slug } = Astro.params;
const story = findCustomerStory(slug ?? '');
if (!story) return Astro.rewrite('/404');

export const prerender = false;
---

<CustomerStoryDetailPage story={story} />
