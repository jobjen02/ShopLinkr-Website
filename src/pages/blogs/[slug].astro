---
import { getCollection } from 'astro:content';
import BlogArticlePage from '../../components/pages/BlogArticlePage.astro';
import { authorSchema } from '../../utils/author';
import { articleDateLabel, dateModified } from '../../utils/articleDate';

const { slug } = Astro.params;

const blogs = await getCollection('blogs');
const blog = blogs.find((b) => b.id === slug);
if (!blog) return Astro.rewrite('/404');

const others = blogs.filter((b) => b.id !== blog.id);
const sameCategory = blog.data.category
    ? others.filter((b) => b.data.category === blog.data.category)
    : [];
const otherIds = new Set(sameCategory.map((b) => b.id));
const fallback = others.filter((b) => !otherIds.has(b.id));
const related = [...sameCategory, ...fallback]
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .slice(0, 3);

const blogsEn = await getCollection('blogsEn');
const enSlug = blogsEn.find((b) => b.data.translationKey === blog.id)?.id ?? null;

const alternates = enSlug
    ? { nl: `/blogs/${blog.id}`, en: `/en/blog/${enSlug}` }
    : undefined;

const formattedDate = articleDateLabel(blog.data.publishedAt, blog.data.updatedAt, 'nl');

const canonicalUrl = `https://www.shoplinkr.com/blogs/${blog.id}`;

const articleSchema = {
    '@type': 'BlogPosting',
    headline: blog.data.title,
    description: blog.data.excerpt,
    datePublished: blog.data.publishedAt.toISOString(),
    dateModified: dateModified(blog.data.publishedAt, blog.data.updatedAt).toISOString(),
    inLanguage: 'nl-NL',
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
    },
    author: authorSchema(blog.data.author, 'nl'),
    publisher: { '@id': 'https://www.shoplinkr.com/#organization' },
    ...(blog.data.image && {
        image: `https://www.shoplinkr.com${blog.data.image}`,
    }),
    ...(blog.data.category && {
        articleSection: blog.data.category,
    }),
};

const breadcrumbSchema = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://www.shoplinkr.com',
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Blog',
            item: 'https://www.shoplinkr.com/blogs',
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: blog.data.title,
            item: canonicalUrl,
        },
    ],
};

const jsonLd = [articleSchema, breadcrumbSchema];

export const prerender = false;
---

<BlogArticlePage
    blog={blog}
    related={related}
    formattedDate={formattedDate}
    alternates={alternates}
    jsonLd={jsonLd}
/>
