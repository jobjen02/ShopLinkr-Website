---
import { localizedPath, routes, type RouteKey } from '../../i18n/routes';
import { localeMeta } from '../../i18n/localeData';
import { useTranslations } from '../../i18n/ui';
// The hero H1 is the LCP element and renders in Inter (latin). Import the woff2 so
// Vite emits it and we get its hashed URL, then preload it below so the browser
// starts fetching before it parses the fontsource stylesheet.
import interHeroWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2';

interface Props {
    title: string;
    description: string;
    image?: string;
    canonical?: string;
    locale?: 'nl' | 'en';
    routeKey?: RouteKey;
    alternates?: { nl?: string; en?: string };
    ogType?: 'website' | 'article';
    publishedTime?: string;
    /** When true, advertise a markdown twin at the canonical URL + ".md". */
    markdown?: boolean;
    /** When true, emit `noindex` instead of the default index directive (e.g. 404). */
    noindex?: boolean;
}

const {
    title,
    description,
    image = '/og-default.png',
    canonical,
    locale = 'nl',
    routeKey,
    alternates: altUrls,
    ogType = 'website',
    publishedTime,
    markdown,
    noindex = false,
} = Astro.props;

// Social crawlers (Facebook/LinkedIn/X) do not render SVG, so fall back to the
// default OG image for any SVG hero. The width/height/type tags below are only
// declared for that known 1200x630 default PNG, not for arbitrary hero images.
const ogImage = image.endsWith('.svg') ? '/og-default.png' : image;
const isDefaultOg = ogImage === '/og-default.png';

// Strip any trailing slash (root stays "/") so the canonical always matches the
// trailingSlash: 'never' URL form, even if a slashed variant is somehow rendered.
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonical
    ? new URL(canonical, Astro.site)
    : new URL(normalizedPath, Astro.site);

const ogLocale = localeMeta[locale].og;
const t = useTranslations(locale);

// Reciprocal hreflang only when the page exists in both locales (routeKey is in
// the map). x-default points to NL so brand/language-agnostic searches land on
// the Dutch version. Pages without an EN twin keep a self-referencing nl +
// x-default, which is correct for an NL-only page.
// Explicit per-page alternates (dynamic pages) win over the static routeKey map.
let altSet: { nl: URL | null; en: URL | null } | null = null;
if (altUrls && (altUrls.nl || altUrls.en)) {
    altSet = {
        nl: altUrls.nl ? new URL(altUrls.nl, Astro.site) : null,
        en: altUrls.en ? new URL(altUrls.en, Astro.site) : null,
    };
} else if (routeKey != null && routeKey in routes) {
    altSet = {
        nl: new URL(localizedPath(routeKey, 'nl'), Astro.site),
        en: new URL(localizedPath(routeKey, 'en'), Astro.site),
    };
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#e8b679" />
<meta name="generator" content={Astro.generator} />

<!-- Preload the hero (LCP) font so it fetches before the fontsource stylesheet is parsed. -->
<link rel="preload" as="font" type="font/woff2" href={interHeroWoff2} crossorigin="anonymous" />

<!-- Google Tag Manager -->
<script is:inline>
    (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-M33XL5PD');
</script>
<!-- End Google Tag Manager -->

<!-- Get Reditus -->
<script is:inline>
    (function (w, d, s, p, t) {
        w.gr =
            w.gr ||
            function () {
                w.gr.ce = 60;
                w.gr.q = w.gr.q || [];
                w.gr.q.push(arguments);
            };
        p = d.getElementsByTagName(s)[0];
        t = d.createElement(s);
        t.async = true;
        t.src = 'https://script.getreditus.com/v2.js';
        p.parentNode.insertBefore(t, p);
    })(window, document, 'script');
    gr('initCustomer', '60a9b8ab-d70a-491b-b09a-7f661e203da3');
    gr('track', 'pageview');
</script>
<!-- End Get Reditus -->

<!-- Featurebase -->
<script is:inline>
    !(function (e, t) {
        var a = 'featurebase-sdk';
        function n() {
            if (!t.getElementById(a)) {
                var e = t.createElement('script');
                (e.id = a), (e.src = 'https://do.featurebase.app/js/sdk.js'), t.getElementsByTagName('script')[0].parentNode.insertBefore(e, t.getElementsByTagName('script')[0]);
            }
        }
        'function' != typeof e.Featurebase &&
            (e.Featurebase = function () {
                (e.Featurebase.q = e.Featurebase.q || []).push(arguments);
            }),
            'complete' === t.readyState || 'interactive' === t.readyState ? n() : t.addEventListener('DOMContentLoaded', n);
    })(window, document);
</script>
<script is:inline define:vars={{ fbLang: locale }}>
    Featurebase('boot', {
        appId: '65ea1a5e61760fa73a313577',
        theme: 'light',
        language: fbLang,
    });
</script>
<!-- End Featurebase -->

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="canonical" href={canonicalURL} />
<meta
    name="robots"
    content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
/>

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site)} />
{
    isDefaultOg && (
        <>
            <meta property="og:image:type" content="image/png" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
        </>
    )
}
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="ShopLinkr" />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
<meta name="twitter:image:alt" content={title} />

{
    altSet ? (
        <>
            {altSet.nl && <link rel="alternate" hreflang="nl" href={altSet.nl} />}
            {altSet.en && <link rel="alternate" hreflang="en" href={altSet.en} />}
            <link rel="alternate" hreflang="x-default" href={altSet.nl ?? altSet.en} />
        </>
    ) : (
        <>
            <link rel="alternate" hreflang="nl" href={canonicalURL} />
            <link rel="alternate" hreflang="x-default" href={canonicalURL} />
        </>
    )
}

<!-- Inter is self-hosted via @fontsource-variable/inter (imported in BaseLayout), no external render-blocking request. -->

<!-- FontAwesome loaded non-blocking so it never delays first paint / LCP; noscript keeps icons for no-JS clients. -->
{
    ['fontawesome', 'solid', 'regular', 'duotone'].map((f) => (
        <link
            rel="stylesheet"
            href={`/fontawesome/css/${f}.min.css`}
            media="print"
            onload="this.media='all'"
        />
    ))
}
<noscript>
    <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/regular.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/duotone.min.css" />
</noscript>

<link rel="sitemap" href="/sitemap-index.xml" />
<link
    rel="alternate"
    type="application/rss+xml"
    title={t.feed.title}
    href={new URL(localizedPath('rss', locale), Astro.site)}
/>
{markdown && <link rel="alternate" type="text/markdown" href={new URL(`${canonicalURL.pathname.replace(/\/$/, '')}.md`, Astro.site)} />}
