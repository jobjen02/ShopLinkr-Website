---
import type { Locale } from '../i18n/routes';
import { getAuthor, authorRole, authorBioText, authorHref } from '../utils/author';

interface Props {
    name?: string;
    locale: Locale;
}

const { name, locale } = Astro.props;
const author = getAuthor(name);
const role = authorRole(author, locale);
const bio = authorBioText(author, locale);
const writtenBy = locale === 'en' ? 'Written by' : 'Geschreven door';
---

<div class="mt-12 flex items-start gap-4 rounded-xl bg-chalk-light dark:bg-graphite p-6 md:p-7 border border-chalk-dark/60 dark:border-flint">
    <img
        src={author.photo}
        alt={author.name}
        width="56"
        height="56"
        loading="lazy"
        class="flex-none h-14 w-14 rounded-full object-cover"
    />
    <div class="flex-1 min-w-0">
        <p class="text-[12px] uppercase tracking-wider text-gravel mb-1">{writtenBy}</p>
        <p class="text-[15px] font-semibold text-charcoal dark:text-paper">
            <a href={authorHref(author.slug, locale)} class="hover:text-sunstone-deep transition-colors">{author.name}</a><span class="text-steel dark:text-gravel font-normal">, {role}</span>
        </p>
        <p class="mt-1.5 text-[14px] text-steel dark:text-gravel leading-relaxed">{bio}</p>
        {author.linkedin && (
            <a
                href={author.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-semibold text-sunstone-deep hover:text-sunstone transition-colors"
            >
                LinkedIn
                <i class="fa-solid fa-arrow-up-right-from-square text-[11px]" aria-hidden="true"></i>
            </a>
        )}
    </div>
</div>
