---
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../sections/CtaBanner.astro';
import FaqList from '../template/FaqList.astro';
import { externalLinks } from '../../data/externalLinks';
import { competitors, type CompetitorKey } from '../../data/competitors';
import { localizeHref, localizedPath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { localeMeta } from '../../i18n/localeData';
import { breadcrumbs } from '../../utils/seo';

interface Props {
    competitorKey: CompetitorKey;
}

const { competitorKey } = Astro.props;
const competitor = competitors[competitorKey];

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const p = competitor.content[locale].vs;

const storyHref = `${localizedPath('customerStories', locale)}/${p.quote.storySlug}`;

const jsonLd = [
    {
        '@type': 'WebPage',
        name: p.heading,
        description: p.description,
        inLanguage: localeMeta[locale].bcp47,
    },
    breadcrumbs([
        ['Home', localizeHref('/', locale)],
        [p.breadcrumbLeaf, localizedPath(competitor.vsRouteKey, locale)],
    ]),
    {
        '@type': 'FAQPage',
        mainEntity: p.faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
            },
        })),
    },
];
---

<PageLayout
    title={p.title}
    description={p.description}
    eyebrow={p.eyebrow}
    heading={p.heading}
    subheading={p.subheading}
    routeKey={competitor.vsRouteKey}
    jsonLd={jsonLd}
>
    <section class="pb-12 md:pb-16 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="flex flex-col sm:flex-row gap-3">
                <a
                    href={externalLinks.register}
                    class="btn btn-sunstone text-base"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t.common.register}
                    <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                </a>
                <a
                    href={externalLinks.demoBooking}
                    class="btn btn-secondary text-base"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t.common.demo}
                </a>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.tldrEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.tldrHeading}
                </h2>
            </div>
            <ol class="mt-8 max-w-3xl space-y-4">
                {
                    p.tldrPoints.map((point, index) => (
                        <li class="flex items-start gap-4 rounded-xl ring-1 ring-chalk-dark dark:ring-flint bg-paper dark:bg-charcoal p-5">
                            <span class="flex-shrink-0 h-7 w-7 rounded-full bg-sunstone-mist dark:bg-sunstone/10 text-sunstone-deep ring-1 ring-sunstone-soft/40 dark:ring-sunstone/30 flex items-center justify-center text-sm font-semibold">
                                {index + 1}
                            </span>
                            <p class="text-base text-steel dark:text-gravel leading-relaxed">{point}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.verdictEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.verdictHeading}
                </h2>
            </div>
            <div class="mt-10 grid md:grid-cols-2 gap-6">
                <div class="rounded-xl ring-2 ring-sunstone-soft/60 dark:ring-sunstone/30 bg-sunstone-mist/40 dark:bg-sunstone/5 p-6 md:p-8">
                    <h3 class="text-lg md:text-xl font-semibold text-charcoal dark:text-paper tracking-tight mb-5">
                        {p.verdictShoplinkrHeading}
                    </h3>
                    <ul class="space-y-3.5">
                        {
                            p.verdictShoplinkr.map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="flex-shrink-0 h-5 w-5 rounded-full bg-sunstone-deep/15 text-sunstone-deep flex items-center justify-center mt-0.5">
                                        <i class="fa-solid fa-check text-[0.6rem]" aria-hidden="true" />
                                    </span>
                                    <p class="text-sm md:text-[0.95rem] text-steel dark:text-gravel leading-relaxed">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div class="rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-8">
                    <h3 class="text-lg md:text-xl font-semibold text-charcoal dark:text-paper tracking-tight mb-5">
                        {p.verdictCompetitorHeading}
                    </h3>
                    <ul class="space-y-3.5">
                        {
                            p.verdictCompetitor.map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="flex-shrink-0 h-5 w-5 rounded-full bg-chalk dark:bg-flint text-steel dark:text-gravel flex items-center justify-center mt-0.5">
                                        <i class="fa-solid fa-check text-[0.6rem]" aria-hidden="true" />
                                    </span>
                                    <p class="text-sm md:text-[0.95rem] text-steel dark:text-gravel leading-relaxed">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-chalk-light dark:bg-graphite">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.tableEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.tableHeading}
                </h2>
                <p class="mt-4 text-lg text-steel dark:text-gravel leading-relaxed">
                    {p.tableIntro}
                </p>
            </div>

            <div class="mt-10 bg-paper dark:bg-charcoal rounded-xl ring-1 ring-chalk-dark dark:ring-flint shadow-[0_12px_40px_-24px_rgba(25,25,25,0.18)] overflow-x-auto">
                <table class="w-full min-w-[680px] text-sm text-left">
                    <thead>
                        <tr class="border-b border-chalk-dark dark:border-flint">
                            <th scope="col" class="px-5 py-4 text-[11px] uppercase tracking-[0.12em] font-semibold text-gravel w-[18%]">
                                {p.colFeature}
                            </th>
                            <th scope="col" class="px-5 py-4 text-sm font-semibold text-sunstone-deep w-[41%]">ShopLinkr</th>
                            <th scope="col" class="px-5 py-4 text-sm font-semibold text-charcoal dark:text-paper w-[41%]">{competitor.name}</th>
                        </tr>
                    </thead>
                    {
                        p.tableGroups.map((group) => (
                            <tbody>
                                <tr class="bg-chalk-light/70 dark:bg-graphite/70 border-b border-chalk-dark dark:border-flint">
                                    <th scope="colgroup" colspan="3" class="px-5 py-3 text-[11px] uppercase tracking-[0.12em] font-semibold text-gravel">
                                        {group.title}
                                    </th>
                                </tr>
                                {group.rows.map((row) => (
                                    <tr class="border-b border-chalk dark:border-flint/60 align-top">
                                        <th scope="row" class="px-5 py-4 font-semibold text-charcoal dark:text-paper whitespace-nowrap">
                                            {row.label}
                                        </th>
                                        <td class="px-5 py-4 text-steel dark:text-gravel leading-relaxed bg-sunstone-mist/20 dark:bg-sunstone/[0.03]">{row.shoplinkr}</td>
                                        <td class="px-5 py-4 text-steel dark:text-gravel leading-relaxed">{row.competitor}</td>
                                    </tr>
                                ))}
                            </tbody>
                        ))
                    }
                </table>
            </div>

            <p class="mt-5 max-w-3xl text-xs text-gravel leading-relaxed">
                {p.tableNote}
            </p>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl space-y-14 md:space-y-20">
                {
                    p.deepDives.map((section) => (
                        <div>
                            <p class="eyebrow mb-4">{section.eyebrow}</p>
                            <h2 class="text-2xl md:text-3xl font-semibold text-charcoal dark:text-paper tracking-tight leading-tight">
                                {section.heading}
                            </h2>
                            <div class="mt-5 space-y-5 text-base md:text-lg text-steel dark:text-gravel leading-relaxed">
                                {section.paragraphs.map((paragraph) => (
                                    <p>{paragraph}</p>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-12 md:py-20 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <figure class="max-w-3xl rounded-xl bg-chalk-light dark:bg-graphite ring-1 ring-chalk-dark dark:ring-flint p-8 md:p-10">
                <i class="fa-solid fa-quote-left text-2xl text-sunstone-deep/50" aria-hidden="true"></i>
                <blockquote class="mt-4 text-xl md:text-2xl text-charcoal dark:text-paper font-medium leading-snug tracking-tight">
                    {p.quote.text}
                </blockquote>
                <figcaption class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
                    <span class="text-sm font-semibold text-steel dark:text-gravel">{p.quote.author}</span>
                    <a
                        href={storyHref}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-sunstone-deep hover:text-charcoal dark:hover:text-paper transition-colors"
                    >
                        {p.quote.linkLabel}
                        <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                    </a>
                </figcaption>
            </figure>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="grid md:grid-cols-2 gap-6">
                <div class="rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-8">
                    <h2 class="text-xl md:text-2xl font-semibold text-charcoal dark:text-paper tracking-tight mb-6">
                        {p.strengthsShoplinkrHeading}
                    </h2>
                    <ul class="space-y-4">
                        {
                            p.strengthsShoplinkr.map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="flex-shrink-0 h-5 w-5 rounded-full bg-green/10 dark:bg-green/15 text-green flex items-center justify-center mt-0.5">
                                        <i class="fa-solid fa-check text-[0.6rem]" aria-hidden="true" />
                                    </span>
                                    <p class="text-sm text-steel dark:text-gravel leading-relaxed">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div class="rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-8">
                    <h2 class="text-xl md:text-2xl font-semibold text-charcoal dark:text-paper tracking-tight mb-6">
                        {p.strengthsCompetitorHeading}
                    </h2>
                    <ul class="space-y-4">
                        {
                            p.strengthsCompetitor.map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="flex-shrink-0 h-5 w-5 rounded-full bg-chalk dark:bg-flint text-steel dark:text-gravel flex items-center justify-center mt-0.5">
                                        <i class="fa-solid fa-check text-[0.6rem]" aria-hidden="true" />
                                    </span>
                                    <p class="text-sm text-steel dark:text-gravel leading-relaxed">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.switchEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.switchHeading}
                </h2>
                <p class="mt-6 text-lg text-steel dark:text-gravel leading-relaxed">
                    {p.switchBody}
                </p>
                <a
                    href={localizedPath(competitor.altRouteKey, locale)}
                    class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-sunstone-deep hover:text-charcoal dark:hover:text-paper transition-colors"
                >
                    {p.switchLinkLabel}
                    <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.faqEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1] mb-10">
                    {p.faqHeading}
                </h2>

                <FaqList items={p.faqs} />
            </div>
        </div>
    </section>

    <section class="pb-12 md:pb-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-8">
                <p class="eyebrow mb-3">{p.sourcesEyebrow}</p>
                <h2 class="text-lg md:text-xl font-semibold text-charcoal dark:text-paper tracking-tight">
                    {p.sourcesHeading}
                </h2>
                <p class="mt-3 text-sm text-steel dark:text-gravel leading-relaxed">
                    {p.sourcesIntro}
                </p>
                <ul class="mt-4 space-y-2">
                    {
                        p.sources.map((source) => (
                            <li>
                                <a
                                    href={source.url}
                                    target="_blank"
                                    rel="noopener noreferrer nofollow"
                                    class="inline-flex items-center gap-2 text-sm text-sunstone-deep hover:text-charcoal dark:hover:text-paper transition-colors"
                                >
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[0.6rem]" aria-hidden="true" />
                                    {source.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </section>

    <CtaBanner />
</PageLayout>
