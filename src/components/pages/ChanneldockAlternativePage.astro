---
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../sections/CtaBanner.astro';
import FaqList from '../template/FaqList.astro';
import { externalLinks } from '../../data/externalLinks';
import { localizeHref, localizedPath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { localeMeta } from '../../i18n/localeData';
import { breadcrumbs } from '../../utils/seo';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const p = t.pages.channeldockAlternative;

const jsonLd = [
    {
        '@type': 'WebPage',
        name: p.heading,
        description: p.description,
        inLanguage: localeMeta[locale].bcp47,
    },
    breadcrumbs([
        ['Home', localizeHref('/', locale)],
        [p.breadcrumbLeaf, localizeHref('/channeldock-alternatief', locale)],
    ]),
    {
        '@type': 'FAQPage',
        mainEntity: p.faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
            },
        })),
    },
];
---

<PageLayout
    title={p.title}
    description={p.description}
    eyebrow={p.eyebrow}
    heading={p.heading}
    subheading={p.subheading}
    routeKey="channeldockAlternative"
    jsonLd={jsonLd}
>
    <section class="pb-12 md:pb-16 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="flex flex-col sm:flex-row gap-3">
                <a
                    href={externalLinks.register}
                    class="btn btn-sunstone text-base"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t.common.register}
                    <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                </a>
                <a
                    href={externalLinks.demoBooking}
                    class="btn btn-secondary text-base"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t.common.demo}
                </a>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.reasonsEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.reasonsHeading}
                </h2>
            </div>
            <div class="mt-10 grid md:grid-cols-2 gap-6">
                {
                    p.reasons.map((reason, index) => (
                        <div class:list={['rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-8', index === p.reasons.length - 1 && 'md:col-span-2']}>
                            <span class="inline-flex h-8 w-8 rounded-full bg-sunstone-mist dark:bg-sunstone/10 text-sunstone-deep ring-1 ring-sunstone-soft/40 dark:ring-sunstone/30 items-center justify-center text-sm font-semibold mb-4">
                                {index + 1}
                            </span>
                            <h3 class="text-lg md:text-xl font-semibold text-charcoal dark:text-paper tracking-tight mb-3">
                                {reason.title}
                            </h3>
                            <p class="text-sm md:text-base text-steel dark:text-gravel leading-relaxed">{reason.body}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-chalk-light dark:bg-graphite">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.honestEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.honestHeading}
                </h2>
                <p class="mt-6 text-lg text-steel dark:text-gravel leading-relaxed">
                    {p.honestBody}
                </p>
                <a
                    href={localizedPath('channeldockVsShoplinkr', locale)}
                    class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-sunstone-deep hover:text-charcoal dark:hover:text-paper transition-colors"
                >
                    {p.compareLinkLabel}
                    <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.stepsEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.stepsHeading}
                </h2>
            </div>
            <ol class="mt-10 grid md:grid-cols-3 gap-6">
                {
                    p.steps.map((step, index) => (
                        <li class="rounded-xl ring-1 ring-chalk-dark dark:ring-flint p-6">
                            <span class="inline-flex h-8 w-8 rounded-full bg-charcoal dark:bg-paper text-paper dark:text-charcoal items-center justify-center text-sm font-semibold mb-4">
                                {index + 1}
                            </span>
                            <h3 class="text-lg font-semibold text-charcoal dark:text-paper tracking-tight mb-3">{step.title}</h3>
                            <p class="text-sm text-steel dark:text-gravel leading-relaxed">{step.body}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="py-12 md:py-24 bg-paper dark:bg-charcoal">
        <div class="container-prose">
            <div class="max-w-3xl">
                <p class="eyebrow mb-4">{p.faqEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1] mb-10">
                    {p.faqHeading}
                </h2>

                <FaqList items={p.faqs} />
            </div>
        </div>
    </section>

    <CtaBanner />
</PageLayout>
