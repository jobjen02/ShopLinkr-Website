---
import PageLayout from '../../layouts/PageLayout.astro';
import { externalLinks } from '../../data/externalLinks';
import { breadcrumbs } from '../../utils/seo';
import { type Locale, localizeHref, localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { customerStories } from '../../data/customerStories';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const p = t.pages.customerStories;

const storiesBase = localizedPath('customerStories', locale);

// Compact cards for the index. Each links through to its detail page. The card
// text is per-locale; the rest is locale-invariant and comes from the data file.
const cards = customerStories.map((s) => ({
    company: s.company,
    logo: s.logo,
    href: `${storiesBase}/${s.slug}`,
    teaser: s.content[locale].teaser,
    highlight: s.content[locale].highlight,
}));

// Quote text is locale-varying and already lives in t.testimonials.quotes (same
// order); author/company/logo are locale-invariant so they stay here.
const voices = [
    {
        quote: t.testimonials.quotes[0],
        author: 'Jasper de Waard',
        company: 'Schoongedaan',
        logo: '/testimonials/Schoongedaan.png',
    },
    {
        quote: t.testimonials.quotes[1],
        author: 'Tijn Zuijdervliet',
        company: 'Cryptoken',
        logo: '/testimonials/Cryptoken.svg',
    },
    {
        quote: t.testimonials.quotes[2],
        author: 'Nabodhi van der Lind',
        company: 'Cozy Design',
        logo: '/testimonials/CozyDesign.jpg',
    },
    {
        quote: t.testimonials.quotes[3],
        author: 'Nick Siep',
        company: 'Voordelig Inslaan',
        logo: '/testimonials/VoordeligInslaan.jpg',
    },
];

// The named testimonials, as Review nodes tied to the SoftwareApplication (#software,
// defined on the homepage). This turns the visible quotes into structured, named
// reviews that legitimately back the aggregateRating and feed AI trust signals.
// No reviewRating or datePublished per review: those values are not in the data and
// are deliberately not invented.
const reviewSchema = voices.map((voice) => ({
    '@type': 'Review',
    itemReviewed: {
        '@type': 'SoftwareApplication',
        '@id': 'https://shoplinkr.com/#software',
        name: 'ShopLinkr',
    },
    author: {
        '@type': 'Person',
        name: voice.author,
        worksFor: { '@type': 'Organization', name: voice.company },
    },
    reviewBody: voice.quote,
    publisher: { '@id': 'https://shoplinkr.com/#organization' },
}));

// One Article node per story, each pointing at its own detail page. url/image are
// only included when we have them (never invented).
const storyArticles = customerStories.map((s) => ({
    '@type': 'Article',
    headline: `${p.articleHeadlinePrefix} ${s.company}`,
    description: s.content[locale].metric,
    about: {
        '@type': 'Organization',
        name: s.company,
        ...(s.url ? { url: s.url } : {}),
    },
    author: { '@id': 'https://shoplinkr.com/#organization' },
    publisher: { '@id': 'https://shoplinkr.com/#organization' },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://shoplinkr.com${storiesBase}/${s.slug}`,
    },
    ...(s.logo ? { image: `https://shoplinkr.com${s.logo}` } : {}),
}));

const jsonLd = [
    breadcrumbs([
        ['Home', localizeHref('/', locale)],
        [p.breadcrumbLabel, localizeHref('/referenties', locale)],
    ]),
    ...storyArticles,
    ...reviewSchema,
];
---

<PageLayout
    title={p.title}
    description={p.description}
    eyebrow={p.eyebrow}
    heading={p.heading}
    subheading={p.subheading}
    routeKey="customerStories"
    jsonLd={jsonLd}
>
    <section class="py-12 md:py-32">
        <div class="container-prose">
            <div class="max-w-2xl mb-8 md:mb-16">
                <p class="eyebrow mb-4">{p.storiesEyebrow}</p>
                <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                    {p.storiesHeading}
                </h2>
            </div>

            <div class="grid md:grid-cols-2 gap-5 md:gap-6">
                {
                    cards.map((card) => (
                        <a
                            href={card.href}
                            class="group flex flex-col bg-paper dark:bg-charcoal rounded-xl ring-1 ring-chalk-dark dark:ring-flint hover:ring-sunstone-soft dark:hover:ring-sunstone/40 hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)] transition-all p-8 md:p-10"
                        >
                            {card.logo ? (
                                <div class="inline-flex self-start items-center bg-paper dark:bg-paper rounded-lg ring-1 ring-chalk-dark dark:ring-flint px-3.5 h-12 mb-6">
                                    <img
                                        src={card.logo}
                                        alt={card.company}
                                        class="h-6 md:h-7 w-auto max-w-[160px] object-contain"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <h3 class="text-xl md:text-2xl font-semibold text-charcoal dark:text-paper tracking-tight mb-6">
                                    {card.company}
                                </h3>
                            )}

                            <p class="text-steel dark:text-gravel leading-relaxed text-[1.0625rem] mb-6 flex-1">
                                {card.teaser}
                            </p>

                            <div class="inline-flex self-start items-center gap-2 rounded-full bg-sunstone-mist/60 dark:bg-sunstone/10 ring-1 ring-sunstone-soft/50 dark:ring-sunstone/30 px-4 py-2 mb-8">
                                <i class="fa-solid fa-chart-line text-sunstone-deep text-sm" aria-hidden="true" />
                                <span class="text-sm font-semibold text-charcoal dark:text-paper">{card.highlight}</span>
                            </div>

                            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-charcoal dark:text-paper mt-auto">
                                {p.readStory}
                                <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1" aria-hidden="true" />
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-12 md:py-32 bg-chalk-light dark:bg-graphite">
        <div class="container-prose">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8 md:mb-16">
                <div class="max-w-2xl">
                    <p class="eyebrow mb-4">{p.voicesEyebrow}</p>
                    <h2 class="text-3xl md:text-4xl font-semibold text-charcoal dark:text-paper tracking-tight leading-[1.1]">
                        {p.voicesHeading}
                    </h2>
                </div>

                <div class="flex items-center gap-3 text-sm">
                    <span class="inline-flex items-center gap-0.5 text-sunstone-deep">
                        {Array.from({ length: 5 }).map(() => (
                            <i class="fa-solid fa-star text-[0.95rem]" aria-hidden="true"></i>
                        ))}
                    </span>
                    <span class="font-semibold text-charcoal dark:text-paper">{p.rating}</span>
                    <span class="text-steel dark:text-gravel">{p.ratingSuffix}</span>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-5 md:gap-6">
                {
                    voices.map((voice) => (
                        <article class="bg-paper dark:bg-charcoal rounded-xl ring-1 ring-chalk-dark dark:ring-flint hover:ring-chalk-darker dark:hover:ring-steel transition-colors p-8 md:p-10 flex flex-col">
                            <p class="text-charcoal dark:text-paper leading-relaxed text-[1.0625rem] mb-8 flex-1">
                                {voice.quote}
                            </p>

                            <div class="flex items-center gap-4">
                                <div class="h-10 w-10 rounded-lg bg-paper dark:bg-paper ring-1 ring-chalk-dark dark:ring-flint flex items-center justify-center overflow-hidden flex-shrink-0">
                                    <img
                                        src={voice.logo}
                                        alt=""
                                        class="h-full w-full object-contain p-1.5"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="min-w-0">
                                    <p class="font-semibold text-charcoal dark:text-paper text-sm">{voice.author}</p>
                                    <p class="text-xs text-steel dark:text-gravel mt-0.5">{voice.company}</p>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>

            <div class="mt-12 flex justify-center">
                <a
                    href="https://nl.trustpilot.com/review/shoplinkr.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-steel dark:text-gravel hover:text-charcoal dark:hover:text-paper transition-colors inline-flex items-center gap-1.5 py-2 min-h-11"
                >
                    {p.allReviews}
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="py-12 md:py-32">
        <div class="container-prose">
            <div class="max-w-2xl mx-auto text-center">
                <p class="eyebrow mb-4">{p.ctaEyebrow}</p>
                <h2 class="text-2xl md:text-3xl font-semibold text-charcoal dark:text-paper tracking-tight">
                    {p.ctaHeading}
                </h2>
                <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
                    <a
                        href={externalLinks.register}
                        class="btn btn-sunstone text-base"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.common.register}
                        <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                    </a>
                    <a
                        href={externalLinks.demoBooking}
                        class="btn btn-secondary text-base"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t.common.demo}
                    </a>
                </div>
            </div>
        </div>
    </section>
</PageLayout>
