---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../sections/CtaBanner.astro';
import { type Locale, type RouteKey, localizeHref, localizedPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { collectionName, localeMeta } from '../../i18n/localeData';
import { breadcrumbs } from '../../utils/seo';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const p = t.pages.guides;

// Root-served SEO landing pages live in the seo / seoEn collection. They are
// reachable at /<slug> (NL) and /en/<slug> (EN). This hub gives them a single
// discoverable home grouped by theme, so they are no longer orphaned.
const seoPages = await getCollection(collectionName('seo', locale));
const base = locale === 'en' ? '/en' : '';

type GroupKey = 'voorraadbeheer' | 'excel' | 'bol' | 'koppelingen';
const ORDER: GroupKey[] = ['voorraadbeheer', 'excel', 'bol', 'koppelingen'];

function groupOf(id: string): GroupKey {
    if (id.includes('hoe-koppel-ik') || id.includes('how-to-connect')) return 'koppelingen';
    if (id.includes('excel')) return 'excel';
    if (id.includes('bol')) return 'bol';
    return 'voorraadbeheer';
}

// Bespoke SEO landing pages live as standalone routes, not in the seo
// collection, so the hub lists them here too. This de-orphans the keyword
// pages that previously had no inbound internal links at all.
const LANDING_PAGES: Record<GroupKey, RouteKey[]> = {
    voorraadbeheer: ['inventoryManagement', 'inventorySoftware', 'inventorySystem', 'inventoryWebshop', 'simpleInventory', 'efficientWebshop'],
    excel: ['inventoryExcel'],
    bol: ['bolInventory', 'multipleBolAccounts'],
    koppelingen: ['wooInventorySync'],
};

const landingCopy = t.pages as Record<string, { title: string; description: string; heading: string }>;

type Card = { href: string; title: string; excerpt: string };

const grouped = ORDER.map((key) => {
    const fromCollection: Card[] = seoPages
        .filter((page) => groupOf(page.id) === key)
        .map((page) => ({ href: `${base}/${page.id}`, title: page.data.title, excerpt: page.data.excerpt }));
    const fromLanding: Card[] = LANDING_PAGES[key]
        .map((rk) => {
            const copy = landingCopy[rk];
            return copy ? { href: localizedPath(rk, locale), title: copy.heading, excerpt: copy.description } : null;
        })
        .filter((card): card is Card => card !== null);
    const items = [...fromCollection, ...fromLanding].sort((a, b) =>
        a.title.localeCompare(b.title, localeMeta[locale].bcp47),
    );
    return { key, label: p.groups[key], items };
}).filter((g) => g.items.length > 0);

const allCards = grouped.flatMap((g) => g.items);

const jsonLd = [
    breadcrumbs([
        ['Home', localizeHref('/', locale)],
        [p.eyebrow, localizedPath('guides', locale)],
    ]),
    {
        '@type': 'CollectionPage',
        name: p.title,
        description: p.description,
        inLanguage: localeMeta[locale].bcp47,
        hasPart: allCards.map((card) => ({
            '@type': 'Article',
            headline: card.title,
            url: card.href.startsWith('http') ? card.href : `https://shoplinkr.com${card.href}`,
        })),
    },
];
---

<PageLayout
    title={p.title}
    description={p.description}
    eyebrow={p.eyebrow}
    heading={p.heading}
    subheading={p.subheading}
    routeKey="guides"
    jsonLd={jsonLd}
>
    <section class="pb-24 md:pb-32 bg-paper dark:bg-charcoal">
        <div class="container-prose flex flex-col gap-16 md:gap-20">
            {grouped.map((group) => (
                <div>
                    <h2 class="text-2xl md:text-3xl font-semibold text-charcoal dark:text-paper tracking-tight mb-8 md:mb-10">
                        {group.label}
                    </h2>
                    <div class="grid gap-4 md:gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {group.items.map((item) => (
                            <a
                                href={item.href}
                                class="group flex flex-col gap-2 h-full rounded-xl bg-paper dark:bg-charcoal ring-1 ring-chalk-dark dark:ring-flint p-6 md:p-7 transition duration-300 ease-out hover:ring-chalk-darker dark:hover:ring-steel hover:shadow-[0_12px_40px_-20px_rgba(25,25,25,0.18)]"
                            >
                                <h3 class="text-base md:text-lg font-semibold text-charcoal dark:text-paper leading-snug tracking-tight group-hover:text-sunstone-deep transition-colors">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-steel dark:text-gravel leading-relaxed line-clamp-3">
                                    {item.excerpt}
                                </p>
                                <span class="mt-auto pt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-charcoal dark:text-paper group-hover:text-sunstone-deep group-hover:gap-2.5 transition-all">
                                    {p.readMore}
                                    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <CtaBanner />
</PageLayout>
